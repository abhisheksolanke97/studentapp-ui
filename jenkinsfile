pipeline {
    agent {
        label "worker"
    }

    tools {
        maven "maven"
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages {
        stage("checkout") {
            steps{
                git 'https://github.com/abhisheksolanke97/studentapp-ui.git'
                echo 'Clonning is Successful'
            }
        }

        stage("Build"){
            steps{
                sh 'mvn clean package'
            }
            post{
                success{
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        
    }
}