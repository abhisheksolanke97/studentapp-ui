pipeline {
    agent {
        label "worker"
    }

    tools {
        maven "maven"
    }

    environment {
        my_aws_cred = credentials("aws-cred")
    }

    stages {
        stage ('checkout') {
            steps {
                git "https://github.com/abhisheksolanke97/studentapp-ui.git"
                echo "Clonning is Successful"
            }
        }

        stage ('Build') {
            steps {
                sh 'mvn clean package'
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.jar',fingerprint: true 
                }
            }
        }

        stage ('Artifacts to s3') {
            steps{
                sh '''
                    aws s3 cp target/*.war s3://abhishek54321.space/Artifacts/student.war
                '''
            }
        }

        stage ('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('soanr') {
                    sh 'mvn sonar:soanr'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time:5 , unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        
    }
}