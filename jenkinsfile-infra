pipeline {
    agent{
        label "worker"
    }

    tools {
        maven "maven"
    }

    environment{
        my_aws_cred = creadentials('aws-cred')
    }

    stages {
        stage("chechout"){
            steps{
                git "https://github.com/abhisheksolanke97/studentapp-ui.git"
                echo "Clonning is successful"
            }
        }

        stage("Build"){
            steps{
                sh 'mvn clean package'
            }
            post{
                success {
                    archiveArtifacts artifacts: '**/target/*.war',fingerprint: true 
                }
            }
        }

        stage('Artifacts to s3'){
            steps{
                sh '''
                    aws s3 cp target/*.war s3://abhishek54321.space/Artifacts/student_ui.war
                '''
            }
        }

        stage('')
    }
}