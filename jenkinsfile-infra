pipeline {
    agent {
        label "worker"
    }

    tools {
        terraform 'tf'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages {
        stage("Checkout") {
            steps{
                git "https://github.com/abhisheksolanke97/studentapp-ui.git"
                echo "Clonning is Successful"
            }
        }

        stage('Terraform - init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Terraform - validate') {
            steps {
                sh 'terraform validate'
            }
        }

        stage('Terraform - apply') {
            steps {
                sh 'terraform apply --auto-approve'
            }
        }
    }
}